# SPDX-License-Identifier: Apache-2.0
#
# SecLoop lab target -- lab-only database credentials (single source of truth).
#
# These values are deliberately public: they unlock nothing but the throw-away
# `secloop` schema on the isolated 192.168.57.0/24 Vagrant network, which is
# populated with fake data only. They are NOT secrets and must never be reused
# for anything real. `vagrant/provision/target_setup.sh` reads this file (in the
# KEY=value form below) to provision the database, and `search.php` falls back
# to the same values, so either path yields an identical lab.
#
DB_HOST=127.0.0.1
DB_NAME=secloop
DB_USER=secloop
DB_PASS=secloop
